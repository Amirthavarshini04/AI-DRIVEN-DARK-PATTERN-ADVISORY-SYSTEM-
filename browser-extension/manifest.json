{
  "manifest_version": 3,
  "name": "AI Dark Pattern & Compliance Advisor",
  "version": "1.0.0",
  "description": "Detect deceptive user-interface patterns on Indian E-Commerce platforms under CCPA Guidelines 2023.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Dark Pattern Scanner"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
