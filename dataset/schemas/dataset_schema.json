{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DarkPatternDatasetSample",
  "type": "object",
  "required": [
    "sample_id",
    "platform",
    "language",
    "text_snippet",
    "dark_pattern_category",
    "ccpa_reference",
    "severity",
    "split"
  ],
  "properties": {
    "sample_id": { "type": "string" },
    "platform": { "type": "string" },
    "language": { "type": "string", "enum": ["en", "hi", "ta"] },
    "text_snippet": { "type": "string" },
    "context": { "type": "string" },
    "dark_pattern_category": { "type": "string" },
    "ccpa_reference": { "type": "string" },
    "severity": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
    "annotator_id": { "type": "string" },
    "split": { "type": "string", "enum": ["train", "val", "test"] }
  }
}
